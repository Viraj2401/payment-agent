# Optional: enables LLM-based extraction of messy user input.
# Without a key the agent still works using its deterministic parser.
GEMINI_API_KEY=your-key-here

# Model used for extraction (fast/cheap tier is intentional; see DESIGN.md)
EXTRACTOR_MODEL=gemini-2.5-flash

# Payment/verification API base URL
API_BASE_URL=https://se-payment-verification-api.service.external.usea2.aws.prodigaltech.com
